{
  "entities": {
    "users": {
      "title": "User Profiles",
      "description": "User profiles for Allô Dabou VTC customers and drivers",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "driver_pending", "driver", "admin"] },
        "isApprovedDriver": { "type": "boolean" },
        "vehicleNumber": { "type": "string" },
        "fcmToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    },
    "rides": {
      "title": "Ride Bookings",
      "description": "Taxi-moto ride bookings in Dabou",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userPhone": { "type": "string" },
        "pickupAddress": { "type": "string" },
        "pickupLat": { "type": "number" },
        "pickupLng": { "type": "number" },
        "destinationAddress": { "type": "string" },
        "destinationLat": { "type": "number" },
        "destinationLng": { "type": "number" },
        "distanceKm": { "type": "number" },
        "durationMin": { "type": "number" },
        "priceFcfa": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "pickupAddress", "destinationAddress", "distanceKm", "priceFcfa", "status"]
    }
  }
}
